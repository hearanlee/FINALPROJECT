{
  "name": "gpt-inference-client",
  "version": "1.0.0",
  "description": "Azure AI Inference client for GPT models",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "server": "node server.js",
    "backend": "cd backend && python run.py",
    "frontend": "npm run server",
    "dev:full": "concurrently \"npm run backend\" \"npm run frontend\"",
    "clean": "rimraf dist"
  },
  "keywords": ["azure", "ai", "inference", "gpt"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "openai": "^4.47.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.0",
    "rimraf": "^5.0.0",
    "concurrently": "^8.2.2"
  }
}
